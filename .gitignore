# Stow symlinks whole dirs (~/.config/fish -> dotfiles/.config/fish), so anything
# an app writes next to its config lands here. Keep that runtime state out.

# fish universal variables (can hold tokens/env set with `set -U`)
.config/fish/fish_variables
.config/fish/conf.d/*.local.fish

# app state / caches / logs
.config/btop/btop.log
.config/yazi/*.state
*.log
*.swp
*~
.DS_Store
__pycache__/

# local secrets/overrides, if ever added
*.local
.env

# generated by matugen from the wallpaper (see .config/matugen/config.toml)
.config/hypr/modules/accent.lua
.config/hypr/hyprlock-accent.conf
.config/kitty/accent.conf
.config/btop/themes/mono-accent.theme
.config/nvim/lua/accent.lua
.config/quickshell/colors.json
